<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>ValkeyDotNet.IntegrationTests</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <Compile
            Include="../../benchmarks/ValkeyDotNet.Benchmarks/NotificationMeasurement.cs"
            Link="TestInfrastructure/NotificationMeasurement.cs"
        />
        <Compile
            Include="../../benchmarks/ValkeyDotNet.Benchmarks/NotificationWorkload.cs"
            Link="TestInfrastructure/NotificationWorkload.cs"
        />
        <Compile
            Include="../../benchmarks/ValkeyDotNet.Benchmarks/AllocationSampleSummary.cs"
            Link="TestInfrastructure/AllocationSampleSummary.cs"
        />
        <Compile
            Include="../../benchmarks/ValkeyDotNet.Benchmarks/RoundTripWorkload.cs"
            Link="TestInfrastructure/RoundTripWorkload.cs"
        />
        <Compile
            Include="../../benchmarks/ValkeyDotNet.Benchmarks/RoundTripMeasurement.cs"
            Link="TestInfrastructure/RoundTripMeasurement.cs"
        />
        <Compile
            Include="../../benchmarks/ValkeyDotNet.Benchmarks/OwnedBenchmarkServer.cs"
            Link="TestInfrastructure/OwnedBenchmarkServer.cs"
        />
        <ProjectReference
            Include="../../dev/ValkeyDotNet.MigrationRelay/ValkeyDotNet.MigrationRelay.csproj"
            ReferenceOutputAssembly="false"
        />
        <Compile
            Include="../../dev/ValkeyDotNet.MigrationRelay/RestoreAckLossRelay.cs"
            Link="TestInfrastructure/RestoreAckLossRelay.cs"
        />
        <None
            Include="../../dev/docker-compose.migration.yml"
            Link="docker-compose.migration.yml"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="../../dev/docker-compose.resilience.yml"
            Link="docker-compose.resilience.yml"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <Target Name="CopyMigrationRelay" AfterTargets="Build">
        <ItemGroup>
            <RelayFiles Include="$(MSBuildThisFileDirectory)../../dev/ValkeyDotNet.MigrationRelay/bin/$(Configuration)/net10.0/ValkeyDotNet.MigrationRelay.*" />
        </ItemGroup>
        <Copy SourceFiles="@(RelayFiles)" DestinationFolder="$(OutDir)MigrationRelay" />
    </Target>
</Project>
