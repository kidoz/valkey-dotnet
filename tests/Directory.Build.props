<Project>
    <!-- Inherit the repository-wide policy, then relax test-only settings. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <!--
      CA2007  ConfigureAwait is a library concern. The xUnit runner has no synchronization context
              to deadlock against, so requiring it here would only add noise. The rule stays on for
              src/ValkeyDotNet, which is what matters.
    -->
        <NoWarn>$(NoWarn);CA2007</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ValkeyDotNet/ValkeyDotNet.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
